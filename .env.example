# Copia questo file in .env e cambia i valori. Il file .env non va mai su GitHub.

APP_ENV=production

# Dominio dell'app, per esempio app.tuodominio.it. Lascia :80 se non hai ancora un dominio.
DOMAIN=:80

POSTGRES_USER=trader
POSTGRES_PASSWORD=cambia-questa-password
POSTGRES_DB=trader

# Ogni quanti secondi il motore controlla se una candela si è chiusa.
ENGINE_TICK_SECONDS=60

LOG_LEVEL=INFO

# Firma dei token di accesso: almeno 32 caratteri casuali.
# Si genera con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-questo-segreto-in-produzione

# Chiave che cifra le chiavi API Kraken e dei wallet nel database. Se la perdi, quei segreti non si recuperano.
# Si genera con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_KEY=
